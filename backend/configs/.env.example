# EduAdapt AI — AI Provider Configuration
# ─────────────────────────────────────────
# Copy this file to backend/configs/.env and fill in your keys.
# This file IS committed (as a template). The actual .env is gitignored.

# Choose provider: "openai" | "gemini" | "mock_fallback"
AI_PROVIDER=mock_fallback

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model name — e.g. gpt-4o-mini | gpt-4o | gemini-1.5-flash | gemini-2.0-flash
AI_MODEL=gemini-1.5-flash

# Timeout for API calls (seconds)
AI_TIMEOUT_SECONDS=20
